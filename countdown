#!/usr/bin/env bash
# Launch the countdown timer in a chrome-less (app-mode) Chromium window.
#
# Usage:  ./countdown            # open the timer
#         ./countdown 25m        # open, set 25 minutes and start immediately
#         ./countdown 1h30m      # also: 90s, 5:00, 1:30:00, 10 (= minutes)
#
# Environment overrides:
#   COUNTDOWN_PORT     port for the local server          (default 8765)
#   COUNTDOWN_BROWSER  browser executable to use           (default: first found)
#   COUNTDOWN_SIZE     initial window size, WIDTH,HEIGHT   (default 440,620)
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
port=${COUNTDOWN_PORT:-8765}
size=${COUNTDOWN_SIZE:-440,620}
url="http://localhost:${port}/"
if [[ $# -gt 0 ]]; then
  url+="?t=$(printf '%s' "$1" | sed 's/[^0-9a-zA-Z:.]//g')&autostart=1"
fi

port_open() { (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null; }

# Start the server in the background if nothing is listening yet.
if ! port_open; then
  nohup python3 "${here}/serve.py" --port "${port}" --quiet >/dev/null 2>&1 &
  for _ in $(seq 1 30); do port_open && break; sleep 0.1; done
  port_open || { echo "countdown: server failed to start on port ${port}" >&2; exit 1; }
fi

browser=${COUNTDOWN_BROWSER:-}
if [[ -z $browser ]]; then
  for b in chromium chromium-browser google-chrome-stable google-chrome brave-browser microsoft-edge; do
    if command -v "$b" >/dev/null 2>&1; then browser=$b; break; fi
  done
fi
[[ -n $browser ]] || { echo "countdown: no Chromium-family browser found; set COUNTDOWN_BROWSER" >&2; exit 1; }

exec "$browser" --app="${url}" --window-size="${size}" >/dev/null 2>&1
